# ============================================================
# SpikeGate — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# LLM Provider (used by agent/nodes/policy_reasoner.py)
# ----------------------------------------------------------
# Which provider to use: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API key (required when LLM_PROVIDER=gemini)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name (default: gemini-1.5-flash — fast, structured-output capable)
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API key (required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# ----------------------------------------------------------
# Database Paths
# ----------------------------------------------------------
# Append-only audit log database
AUDIT_DB_PATH=audit_log.db

# Merchant context lookup database (seeded at startup)
CONTEXT_DB_PATH=data/merchant_context.db

# ----------------------------------------------------------
# Detector / Scoring Thresholds (bounds_gate hard overrides)
# ----------------------------------------------------------
# spike_score >= this → always auto_block (LLM overridden)
SPIKE_HARD_BLOCK_THRESHOLD=0.90

# spike_score >= this AND merchant tier = "high" → auto_block
SPIKE_HIGH_RISK_THRESHOLD=0.70

# spike_score <= this → always allow (skip LLM call)
SPIKE_ALLOW_THRESHOLD=0.15

# ----------------------------------------------------------
# Synthetic Data Generator (data_gen/)
# ----------------------------------------------------------
# Random seed for reproducibility
DATAGEN_SEED=42

# Simulation duration in hours (used for offline batch generation)
DATAGEN_HOURS=24

# Number of synthetic merchants
DATAGEN_N_MERCHANTS=50

# Baseline transactions per second across all merchants
DATAGEN_BASE_TPS=2.0

# Probability per second that a spike burst starts on some entity
DATAGEN_SPIKE_PROB=0.02

# ----------------------------------------------------------
# Evaluation (eval/)
# ----------------------------------------------------------
# Train/test split fraction (held-out portion for eval)
EVAL_TEST_SPLIT=0.20

# Path where eval report is written
EVAL_REPORT_PATH=eval/report.md

# ----------------------------------------------------------
# Dashboard (dashboard/)
# ----------------------------------------------------------
# Streamlit server port
DASHBOARD_PORT=8501

# Speed multiplier for stream replay (1.0 = real-time, 10.0 = 10x faster)
STREAM_REPLAY_SPEED=10.0
